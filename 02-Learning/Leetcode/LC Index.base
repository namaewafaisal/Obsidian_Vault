views:
  - type: table
    name: View
    filters:
      or:
        - file.folder == "02-Learning/Leetcode/Problems"
    groupBy:
      property: patterns
      direction: ASC
    order:
      - file.name
      - difficulty
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 448
